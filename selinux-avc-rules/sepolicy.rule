# GSI mixing cosmetics: system_app probing radio hwservices that this
# vendor does not provide (samsung/spreadtrum/huawei/qti ifaces) lands on
# default_android_hwservice and floods auditd with find denials.
allow system_app default_android_hwservice hwservice_manager find
allow system_app default_android_service service_manager find
allow system_server default_android_hwservice hwservice_manager find
allow system_server default_android_service service_manager find
allow radio default_android_hwservice hwservice_manager find
allow radio default_android_service service_manager find
allow surfaceflinger default_android_hwservice hwservice_manager find
allow hal_fingerprint_oppo_compat default_android_hwservice hwservice_manager find

# vendor fingerprint HAL probing nonexistent oppo/oplus hwservices.
# (hal_fingerprint_oppo_compat handled above)

# recurring process-getattr audit spam from system_server on GSI mix.
allow system_server radio process getattr
allow system_server gmscore_app process getattr
allow system_server platform_app process getattr
allow system_server priv_app process getattr
allow system_server untrusted_app process getattr
allow system_server bluetooth process getattr
allow system_server system_app process getattr
allow system_server device_as_webcam process getattr
allow system_server audioserver process getattr
allow system_server cameraserver process getattr
allow system_server mediaextractor process getattr
allow system_server mediametrics process getattr
allow system_server mediaprovider_app process getattr
allow system_server mediaserver process getattr
allow system_server mtk_hal_gnss process getattr
allow system_server netd process getattr
allow system_server network_stack process getattr
allow system_server nfc process getattr
allow system_server permissioncontroller_app process getattr
allow system_server secure_element process getattr
allow system_server shared_relro process getattr
allow system_server statsd process getattr
allow system_server surfaceflinger process getattr
allow surfaceflinger platform_app process getattr
allow surfaceflinger bootanim process getattr
allow surfaceflinger system_app process getattr
allow surfaceflinger system_server process getattr
allow mtk_hal_power surfaceflinger process getattr
allow mtk_hal_power system_server process getattr
allow vold system_server process getattr
allow vold apexd process getattr
allow vold vdc process getattr

# surfaceflinger binder getattr noise on app domains.
allow surfaceflinger priv_app process getattr
allow surfaceflinger untrusted_app process getattr

# system_server probing mediaprovider + su (rooted adb) domains.
allow system_server mediaprovider process getattr
allow system_server mediaprovider_app process getattr
allow system_server su process getattr

# system_server CachedAppOptimizer writing to zygote tmpfs (GSI mix).
allow system_server zygote_tmpfs file write

# ---------------------------------------------------------------
# events-buffer audit spam (daemon reads log_id_events stream)
# these are legitimate kernel-sysfs / binder health checks that the
# GSI/vendor mix simply never granted; allow = silence, not masking.
# ---------------------------------------------------------------

# THE big one: system_server probing system_suspend wakelock state (~1/s).
allow system_server system_suspend process getattr

# system_suspend reading battery rails via sysfs before suspend.
allow system_suspend sysfs dir read
allow system_suspend sysfs_batteryinfo dir read

# system_server binder getattr on early-boot vendor services.
allow system_server keystore process getattr
allow system_server rkpdapp process getattr
allow system_server flipendo process getattr
allow system_server isolated_app process getattr
allow system_server shell process getattr
allow system_server storaged process getattr

# gmscore FILE read from priv_app (gservices) and process getattr (sf).
allow priv_app gmscore_app file read
allow surfaceflinger gmscore_app process getattr
# priv_app scanning /proc/<gmscore pid> (dir search on the proc dir).
allow priv_app gmscore_app dir search
# priv_app opening /proc/<gmscore pid>/attr/current (same walk, needs open).
allow priv_app gmscore_app file open

# gmscore reading adbd properties (adb over wifi polling).
# The tmpfs prop files need open too - read alone covers nothing (see mnld).
allow gmscore_app adbd_prop file read
allow gmscore_app adbd_prop file open
allow gmscore_app system_adbd_prop file read
allow gmscore_app system_adbd_prop file open

# adbroot/adbd capability self checks while rooted adb is running.
allow adbroot self capability sys_ptrace
allow adbd self capability dac_override
allow adbd self capability dac_read_search

# mnld reading ro.* default_prop (open + read on the tmpfs prop files).
allow mnld default_prop file open
allow mnld default_prop file read

# Fallback for the KernelSU /vendor overlay, for the two vendor domains that
# load a patched library through it. The four overlay modules relabel their own
# payload to vendor_file in post-fs-data.sh, so these rules should never be
# needed - they are here because the relabel runs after KernelSU has already
# mounted the overlay, and a vendor HAL that lost its library is fatal:
# mtk_hal_power not linking android.hardware.power-service-mediatek.so means
# android.hardware.power.IPower/default never registers and the device never
# finishes booting. One perm per line: `ksud sepolicy apply` in 0.9.4 parses only
# the first perm of a line and silently drops the rest.
allow mtk_hal_power system_file file read
allow mtk_hal_power system_file file getattr
allow mtk_hal_power system_file file open
allow mtk_hal_power system_file file map
allow mtk_hal_power system_file file execute
allow eara_io system_file file read
allow eara_io system_file file getattr
allow eara_io system_file file open
allow eara_io system_file file map
allow eara_io system_file file execute
